{
  "name": "freeholder",
  "private": true,
  "version": "0.0.0",
  "description": "The open-source operating system for a one-person business — the deployable monolith: public site + CMS, admin, unified CRM spine, commerce, booking, galleries, mail, analytics, MCP server",
  "license": "AGPL-3.0-only",
  "author": "Tony Aly <tony@paradisemodern.com> (https://tonyaly.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/campdenman/freeholder.git"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "plan:check": "node scripts/plan-gate.mjs",
    "changelog:gate": "node scripts/changelog-gate.mjs",
    "license:check": "node scripts/license-headers.mjs",
    "license:fix": "node scripts/license-headers.mjs --fix",
    "packages:build": "pnpm -r --filter './packages/*' build",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.2",
    "intl-messageformat": "^11.2.12",
    "isbot": "^5.2.1",
    "next": "^16.2.11",
    "nodemailer": "^9.0.3",
    "pg-boss": "^12.26.2",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "axe-core": "^4.12.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.7.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
