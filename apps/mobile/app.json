{
  "expo": {
    "name": "Freeholder",
    "slug": "freeholder-customer",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "freeholder",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true, "bundleIdentifier": "ai.freeholder.customer" },
    "android": { "package": "ai.freeholder.customer", "edgeToEdgeEnabled": true },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": { "typedRoutes": true }
  }
}
