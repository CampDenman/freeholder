# Freeholder environment — secrets and machine-specific values only.
# Everything here is declared and validated in src/core/env.ts.
# Instance shape (adapters, preset, locales) lives in freeholder.config.ts.

# Postgres 15+ connection string (required at runtime)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/freeholder_dev

# Absolute base URL of this instance
APP_URL=http://localhost:3000

# 32+ character random secret for session-token hashing (required in production)
# Generate one: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Throwaway database for the test suite (tests skip without it)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/freeholder_test

# ── Object storage ────────────────────────────────────────────────────────────
# Which implementation runs is set in freeholder.config.ts (adapters.storage).
# These are only needed when it is "s3". The same names work for DigitalOcean
# Spaces, Cloudflare R2, MinIO, Backblaze B2 and AWS S3.
#
# DigitalOcean Spaces example:
#   S3_ENDPOINT=https://sfo3.digitaloceanspaces.com
#   S3_REGION=sfo3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: a CDN or custom domain to serve from, and whether the bucket is
# world-readable. Leave S3_PUBLIC unset for a private bucket (the safe default).
S3_PUBLIC_BASE_URL=
S3_PUBLIC=
