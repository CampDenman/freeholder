# Freeholder environment — secrets and machine-specific values only.
# Everything here is declared and validated in src/core/env.ts.
# Instance shape (adapters, preset, locales) lives in freeholder.config.ts.

# Postgres 15+ connection string (required at runtime)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/freeholder_dev

# Absolute base URL of this instance
APP_URL=http://localhost:3000

# 32+ character random secret for session-token hashing (required in production)
# Generate one: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Encrypts connected third-party accounts at rest (MASTER.md §41). Needed only
# once you connect a Google/Microsoft account; without it nothing can be
# stored, and losing it means re-authorising every connection — so it belongs
# in your backups alongside the database.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_KEY=

# Set only while rotating CREDENTIAL_KEY: put the old value here, deploy, run
# the rotation, then remove it.
CREDENTIAL_KEY_PREVIOUS=

# Throwaway database for the test suite (tests skip without it)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/freeholder_test

# ── Object storage ────────────────────────────────────────────────────────────
# Which implementation runs is set in freeholder.config.ts (adapters.storage).
# These are only needed when it is "s3". The same names work for DigitalOcean
# Spaces, Cloudflare R2, MinIO, Backblaze B2 and AWS S3.
#
# DigitalOcean Spaces example:
#   S3_ENDPOINT=https://sfo3.digitaloceanspaces.com
#   S3_REGION=sfo3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: a CDN or custom domain to serve from, and whether the bucket is
# world-readable. Leave S3_PUBLIC unset for a private bucket (the safe default).
S3_PUBLIC_BASE_URL=
S3_PUBLIC=

# Exact HTTPS origins reviewed third-party creatives may load from, separated
# by commas. They remain blocked unless that visitor explicitly grants the
# separate third-party-creative choice. No paths or wildcards.
CSP_THIRD_PARTY_ORIGINS=

# Optional malware scanner for uploaded originals. The default is honest
# structural validation with scan state "not configured". Point this at a
# self-hosted clamd service to quarantine signatures before files are served.
MALWARE_SCANNER=none
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310

# Optional generated alt-text suggestions. Set adapters.ai to "openai" in
# freeholder.config.ts, then provide both values. No request is made until a
# signed-in media manager clicks "Generate suggestion"; every result still
# requires explicit human review before it becomes authored alt text.
OPENAI_API_KEY=
OPENAI_ALT_TEXT_MODEL=

# ── Demo content ──────────────────────────────────────────────────────────────
# Unset installs Aurora Coast Photography automatically on a pristine
# development database, so the first visit to / is a complete site. Set to 0
# when deliberately testing the blank setup journey. Set to 1 for demo deploys,
# the plugin dev harness, and CI's SEO gate. Read once at startup — there is no
# route that can trigger it — and it refuses to install over existing pages.
FREEHOLDER_SEED_DEMO=
# Optional. Unset = photography demo. law-firm = WeVibeSites Law Firm Edition.
FREEHOLDER_EDITION=

# ── Transactional mail ────────────────────────────────────────────────────────
# Password resets, receipts and notifications. Unset means "console": messages
# are printed to the log and nothing is delivered, which is fine for a laptop
# and is announced loudly in production.
#
# MAIL_ADAPTER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="Aurora Coast <hello@example.com>"
MAIL_ADAPTER=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# OAuth transactional senders. Configure either application, then connect a
# mailbox from Settings. Redirect URLs are:
#   ${APP_URL}/api/mail/oauth/google/callback
#   ${APP_URL}/api/mail/oauth/microsoft/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common

# â”€â”€ Bulk mail â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Campaigns only. Unset/none refuses to broadcast. Verify MAIL_BULK_FROM with
# the selected provider before making it the default sender.
MAIL_BULK_ADAPTER=none
MAIL_BULK_FROM=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
POSTMARK_SERVER_TOKEN=
POSTMARK_ACCOUNT_TOKEN=
POSTMARK_MESSAGE_STREAM=broadcasts
POSTMARK_WEBHOOK_USER=
POSTMARK_WEBHOOK_PASSWORD=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_SESSION_TOKEN=
SES_REGION=
SES_CONFIGURATION_SET=
SES_SNS_TOPIC_ARN=

# â”€â”€ Payments â”€â”€
# Choose manual, stripe, paypal, square, mollie, razorpay, paystack, or
# flutterwave in freeholder.config.ts. Manual/offline money needs no credentials
# and is always owner-attested. Hosted providers are ready only when the API and
# authentication values required by their adapter exist.
# Webhook URLs:
#   ${APP_URL}/api/payments/webhooks/stripe
#   ${APP_URL}/api/payments/webhooks/paypal
#   ${APP_URL}/api/payments/webhooks/square
#   ${APP_URL}/api/payments/webhooks/mollie
#   ${APP_URL}/api/payments/webhooks/razorpay
#   ${APP_URL}/api/payments/webhooks/paystack
#   ${APP_URL}/api/payments/webhooks/flutterwave
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set only during a webhook-secret rotation, then remove after Stripe's grace period.
STRIPE_WEBHOOK_SECRET_PREVIOUS=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Set only while Square retries events signed with the retiring key.
SQUARE_WEBHOOK_SIGNATURE_KEY_PREVIOUS=
SQUARE_ENVIRONMENT=sandbox
MOLLIE_API_KEY=
# Optional for next-generation events; classic payment callbacks are verified
# by fetching the payment through the private Mollie API.
MOLLIE_WEBHOOK_SECRET=
MOLLIE_WEBHOOK_SECRET_PREVIOUS=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
# Paystack signs SHA-512 webhook bodies with this same secret API key.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
# This is the secret hash configured in the Flutterwave webhook dashboard.
FLUTTERWAVE_WEBHOOK_SECRET=
FLUTTERWAVE_WEBHOOK_SECRET_PREVIOUS=
