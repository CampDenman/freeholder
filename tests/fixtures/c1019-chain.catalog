idx	webhook_subscriptions	webhook_subscriptions_status_idx	CREATE INDEX webhook_subscriptions_status_idx ON public.webhook_subscriptions USING btree (status)
idx	wishlist_items	wishlist_items_pkey	CREATE UNIQUE INDEX wishlist_items_pkey ON public.wishlist_items USING btree (id)
idx	wishlist_items	wishlist_items_unique_idx	CREATE UNIQUE INDEX wishlist_items_unique_idx ON public.wishlist_items USING btree (wishlist_id, variant_id)
idx	wishlist_items	wishlist_items_variant_idx	CREATE INDEX wishlist_items_variant_idx ON public.wishlist_items USING btree (variant_id)
idx	wishlists	wishlists_contact_idx	CREATE UNIQUE INDEX wishlists_contact_idx ON public.wishlists USING btree (contact_id)
