# Every value this target needs. Copy to /opt/freeholder/.env on the droplet
# and chmod 600 it — it holds every secret the instance has.

# ── The instance ─────────────────────────────────────────────────────────────
# Must match the domain you pointed at this droplet; Caddy asks Let's Encrypt
# for a certificate covering exactly this name.
FREEHOLDER_DOMAIN=yourdomain.com
APP_URL=https://yourdomain.com
NODE_ENV=production

# 32+ random characters. Rotating this signs every session out.
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres runs on this droplet and is never published to the host; the app
# reaches it over the compose network. DATABASE_URL is assembled in compose.yml
# from this password, so it is not repeated here.
POSTGRES_PASSWORD=

# ── Media (DigitalOcean Spaces) ──────────────────────────────────────────────
# Mandatory (§18): media never lives on droplet disk. Set adapters.storage to
# "s3" in freeholder.config.ts.
S3_ENDPOINT=https://sfo3.digitaloceanspaces.com
S3_REGION=sfo3
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Leave S3_PUBLIC unset for a private bucket — the safe default. Client
# galleries and paywalled files depend on it.
S3_PUBLIC=

# ── Backups ──────────────────────────────────────────────────────────────────
# A second bucket, so a mistake in one is not a mistake in both. Turn on
# versioning for it in the DigitalOcean console.
BACKUP_BUCKET=

# ── Which image to run ───────────────────────────────────────────────────────
# Pin a tag for a reproducible deploy; :latest is fine while you are trying it.
FREEHOLDER_IMAGE=ghcr.io/campdenman/freeholder:latest
