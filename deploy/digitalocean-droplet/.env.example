# Independent random secret required for first owner setup (32+ characters).
BOOTSTRAP_SECRET=
SESSION_SECRET=
CREDENTIAL_KEY=
APP_URL=https://example.com
FREEHOLDER_STORAGE=s3
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_ADDRESSING_STYLE=path
# Versioned bucket for the nightly database backup (backup.sh); the S3 key
# above must have readwrite on it too.
BACKUP_BUCKET=
POSTGRES_PASSWORD=
FREEHOLDER_DOMAIN=example.com
# Set this explicitly when FREEHOLDER_DOMAIN contains multiple hostnames.
FREEHOLDER_PRIMARY_DOMAIN=example.com
