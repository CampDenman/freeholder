# `selfhost.sh prepare` writes deploy/docker-selfhost/.env and generates every
# secret with `openssl rand -hex 32`. This shows what is in it; never use the
# example as a live file.
POSTGRES_PASSWORD=
# Independent random secret required for first owner setup (32+ characters).
BOOTSTRAP_SECRET=
SESSION_SECRET=
CREDENTIAL_KEY=
APP_URL=http://localhost:3000
# For a public site: APP_URL=https://example.com, this hostname, and
# infra/compose.https.yml, whose Caddy obtains the certificate.
FREEHOLDER_DOMAIN=
# The release image; `selfhost.sh update VERSION` changes it.
FREEHOLDER_IMAGE=ghcr.io/campdenman/freeholder:0.2.0-beta.5
# Media on the Compose `media` volume (default) or S3-compatible storage.
FREEHOLDER_STORAGE=local
# For FREEHOLDER_STORAGE=s3:
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_ADDRESSING_STYLE=path
# Backups: hour (UTC) and how many to keep.
BACKUP_HOUR_UTC=3
BACKUP_KEEP=14
