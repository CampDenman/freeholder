[Unit]
Description=Freeholder restricted host update executor
After=docker.service
Requires=docker.service
[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/freeholder/docker-updater.py serve
Restart=on-failure
UMask=0077
RuntimeDirectory=freeholder-updater
RuntimeDirectoryMode=0755
# Keep the directory inode mounted by the app across daemon stops/restarts.
RuntimeDirectoryPreserve=yes
# Let an active cutover finish before stopping this service.
TimeoutStopSec=1800
KillSignal=SIGINT
[Install]
WantedBy=multi-user.target
