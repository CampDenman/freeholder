# Live proxy configuration for the standard app/db/caddy host-updater recipe.
# The executor replaces this file with a 503 maintenance response during a
# cutover and restores this exact content afterwards; keep it under the
# deployment directory named Caddyfile.
{$FREEHOLDER_DOMAIN} {
	# C11.10: the connecting address, overwritten on every request so a
	# client cannot supply its own. The app trusts it only because
	# TRUSTED_CLIENT_IP_HEADER names it and the app port is not published.
	reverse_proxy app:3000 {
		header_up X-Freeholder-Client-Ip {remote_host}
	}
}
