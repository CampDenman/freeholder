# /etc/freeholder/freeholder.env on a native install. `freeholder setup`
# writes it (root:freeholder, mode 640) and generates every secret with
# `openssl rand -hex 32`; you never need to fill it in by hand. Shown here so
# you know what is in it. Never use this example as a live file.
APP_URL=https://example.com
DATABASE_URL=postgres://freeholder:GENERATED@127.0.0.1:5432/freeholder
POSTGRES_PASSWORD=GENERATED
BOOTSTRAP_SECRET=GENERATED
SESSION_SECRET=GENERATED
CREDENTIAL_KEY=GENERATED
TRUSTED_CLIENT_IP_HEADER=x-freeholder-client-ip
FREEHOLDER_SEED_DEMO=0
# Media on this server's disk (default), included in the nightly backup.
FREEHOLDER_STORAGE=local
LOCAL_STORAGE_ROOT=/var/lib/freeholder/media
# Or S3-compatible storage: `freeholder setup --storage s3` asks for these.
# FREEHOLDER_STORAGE=s3
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Optional: Let's Encrypt contact address, backups kept, offsite copy.
# ACME_EMAIL=
# BACKUP_KEEP=14
# BACKUP_RCLONE_REMOTE=offsite:my-backup-bucket/freeholder
